# Site editor. Only index.php, api.php and the CSS/JS are reachable from the web.

Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(lib|config)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
